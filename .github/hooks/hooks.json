{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "git ai-log --tool=copilot",
        "powershell": "git ai-log --tool=copilot",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "git ai-log --tool=copilot",
        "powershell": "git ai-log --tool=copilot",
        "timeoutSec": 10
      }
    ]
  }
}
