{
  "$description": "Prope Heritage Ledger design tokens. Direction A confirmed from moodboard.png; watercolor is a decorative layer only.",
  "$extensions": {
    "com.vibe-to-ui": {
      "profile": "prompt-vault",
      "displayName": "Prope — Heritage Ledger",
      "updatedAt": "2026-08-08",
      "confidence": "high"
    }
  },
  "colors": {
    "$type": "color",
    "primary": { "$value": "#17444C", "$description": "Deep teal ink and primary action" },
    "secondary": { "$value": "#7FACC7", "$description": "Muted sky support" },
    "accent": { "$value": "#FFD42A", "$description": "Decision and call-to-action accent" },
    "background": { "$value": "#FCF8ED", "$description": "Warm ivory canvas" },
    "surface": { "$value": "#FFFCF4", "$description": "Raised paper surface" },
    "surfaceAlt": { "$value": "#ECE8DA", "$description": "Quiet grouped surface" },
    "onSurface": { "$value": "#17444C", "$description": "Primary text" },
    "onSurfaceMuted": { "$value": "#62747A", "$description": "Metadata and supporting text" },
    "border": { "$value": "#DBD6C6", "$description": "Divider and outline" },
    "success": { "$value": "#668A4F", "$description": "Approved / positive state" },
    "warning": { "$value": "#B7791F", "$description": "Attention state" },
    "error": { "$value": "#B14B45", "$description": "Destructive / failed state" },
    "info": { "$value": "#39718B", "$description": "Informational state" }
  },
  "watercolor": {
    "$description": "Decorative watercolor tokens. Do not use these values for interactive, semantic or dense-data surfaces.",
    "colors": {
      "$type": "color",
      "tealWash": { "$value": "#4B7F86", "$description": "Primary teal watercolor pigment" },
      "skyWash": { "$value": "#7FACC7", "$description": "Muted sky watercolor pigment" },
      "sunWash": { "$value": "#FFD84D", "$description": "Light sun-yellow watercolor highlight" },
      "mossWash": { "$value": "#6A8A4E", "$description": "Moss watercolor support pigment" },
      "paperIvory": { "$value": "#F3EAD6", "$description": "Warm paper undertone" }
    },
    "textureIntensity": {
      "$type": "number",
      "low": { "$value": 0.08, "$description": "Fine grain for dense-adjacent or overview surfaces" },
      "medium": { "$value": 0.14, "$description": "Visible but restrained grain for sparse sections and empty states" },
      "high": { "$value": 0.2, "$description": "Editorial illustration only; never behind UI content" }
    },
    "washOpacity": {
      "$type": "number",
      "subtle": { "$value": 0.1, "$description": "Cards, banners and dense-workbench overview framing" },
      "soft": { "$value": 0.16, "$description": "Hero and section backgrounds" },
      "visible": { "$value": 0.24, "$description": "Standalone empty-state or editorial illustration accents" }
    },
    "paperSurface": {
      "$type": "string",
      "default": { "$value": "warm-ivory-matte", "$description": "Base paper surface; use for normal UI surfaces" },
      "grain": { "$value": "fine-matte-grain", "$description": "Low-contrast decorative paper grain" },
      "quiet": { "$value": "plain-opaque-paper", "$description": "No texture; required for tables, forms, navigation and dense text" }
    }
  },
  "fontFamily": {
    "$type": "fontFamily",
    "heading": { "$value": ["Playfair Display", "Georgia", "Times New Roman", "serif"] },
    "body": { "$value": ["Inter", "ui-sans-serif", "system-ui", "Arial", "sans-serif"] },
    "mono": { "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "monospace"] }
  },
  "fontWeight": { "$type": "fontWeight", "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }, "bold": { "$value": 700 } },
  "typography": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{fontFamily.heading}", "fontSize": { "value": 48, "unit": "px" }, "fontWeight": "{fontWeight.semibold}", "lineHeight": 1.1 } },
    "title": { "$value": { "fontFamily": "{fontFamily.heading}", "fontSize": { "value": 32, "unit": "px" }, "fontWeight": "{fontWeight.semibold}", "lineHeight": 1.2 } },
    "body": { "$value": { "fontFamily": "{fontFamily.body}", "fontSize": { "value": 16, "unit": "px" }, "fontWeight": "{fontWeight.regular}", "lineHeight": 1.55 } },
    "label": { "$value": { "fontFamily": "{fontFamily.body}", "fontSize": { "value": 12, "unit": "px" }, "fontWeight": "{fontWeight.semibold}", "lineHeight": 1.25 } }
  },
  "spacing": { "$type": "dimension", "base": { "$value": { "value": 4, "unit": "px" } }, "xs": { "$value": { "value": 4, "unit": "px" } }, "sm": { "$value": { "value": 8, "unit": "px" } }, "md": { "$value": { "value": 16, "unit": "px" } }, "lg": { "$value": { "value": 24, "unit": "px" } }, "xl": { "$value": { "value": 32, "unit": "px" } }, "2xl": { "$value": { "value": 48, "unit": "px" } } },
  "radius": { "$type": "dimension", "sm": { "$value": { "value": 4, "unit": "px" } }, "md": { "$value": { "value": 8, "unit": "px" } }, "lg": { "$value": { "value": 16, "unit": "px" } }, "full": { "$value": { "value": 9999, "unit": "px" } } },
  "motion": {
    "duration": { "$type": "duration", "fast": { "$value": { "value": 120, "unit": "ms" } }, "normal": { "$value": { "value": 180, "unit": "ms" } }, "slow": { "$value": { "value": 260, "unit": "ms" } } },
    "easing": { "$type": "cubicBezier", "standard": { "$value": [0.2, 0.8, 0.2, 1] } },
    "$extensions": { "com.vibe-to-ui": { "signatureMotif": "evidence sweep", "reducedMotion": "static layout; fade-only feedback" } }
  }
}
