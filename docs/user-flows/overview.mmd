flowchart TD
    %% High-level Prope journey map. Detailed states live in numbered Mermaid files.
    %% Authentication and administration are omitted because the source documents do not define those journeys.

    start([Start: prompt work needs preservation or trusted use])
    mode{Personal preservation or enterprise lifecycle?}

    subgraph Personal[Individual user]
        personal[01 Personal Preservation]
    end

    subgraph Owner[Prompt Owner]
        register[02 Register Prompt]
        similar[10 Similar Prompt Check - Deferred P2]
        find[03 Find Trusted Prompt]
        access[04 Manage Ownership and Access]
        revisions[05 Manage Revisions]
        evaluation[06 Prepare Evaluation Evidence]
    end

    subgraph HITL[Reviewer / Approver]
        review[07 Review and Approval]
    end

    subgraph Developer[Developer / AI Engineer]
        release[08 Release Approved Revision]
        restore[09 Restore Revision]
    end

    preserved([End: prompt preserved or reused])
    draft([End: owned Draft preserved])
    trusted([End: trusted revision Approved])
    in_use([End: Approved revision in use])
    recovered([End: previous Approved revision restored])

    start --> mode
    mode -->|Personal| personal
    personal --> preserved

    mode -->|Enterprise| register
    register -->|Optional duplicate prevention| similar
    similar -->|Continue registration| access
    similar -->|Reuse existing prompt| find
    register -->|Prompt registered privately| access
    access -->|Find or reuse| find
    access -->|Create or change revision| revisions
    find -->|Edit permitted| revisions
    revisions -->|Keep Draft| draft
    revisions -->|Prepare for review| evaluation
    evaluation -->|Evidence incomplete or regression requires change| revisions
    evaluation -->|Submit review-ready evidence| review
    review -->|Request changes| revisions
    review -->|Approve trusted revision| trusted
    trusted -->|Release for use| release
    release --> in_use
    in_use -->|Incident or recovery need| restore
    restore --> recovered

