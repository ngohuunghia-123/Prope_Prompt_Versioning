flowchart TD
    %% Enterprise-only MVP journey. Detailed states live in numbered Mermaid files.
    %% Individual mode and similar-prompt checking are explicitly deferred.

    start([Start: enterprise member opens Prope])
    entry[01 Enterprise Registry Entry]

    subgraph Owner[Prompt Owner or Editor]
        register[02 Register Prompt Manually]
        find[03 Find Trusted Prompt]
        access[04 Manage Ownership and Access]
        revisions[05 Manage Revisions]
        evaluation[06 Prepare Evaluation Evidence]
    end

    subgraph HITL[Reviewer or Approver]
        review[07 Review and Approval]
    end

    subgraph Developer[Developer or AI Engineer]
        release[08 Release Approved Revision]
        restore[09 Restore Revision]
    end

    draft([End: owned Draft preserved])
    trusted([End: trusted revision Approved])
    in_use([End: Approved revision released])
    recovered([End: previous Approved revision restored])

    start --> entry
    entry -->|No visible prompt or create new| register
    entry -->|Find existing property| find
    register -->|Draft registered privately| access
    access -->|Create or change revision| revisions
    access -->|Return to Registry| find
    find -->|Edit permitted| revisions
    revisions -->|Keep Draft| draft
    revisions -->|Prepare review evidence| evaluation
    evaluation -->|Incomplete run or revise| revisions
    evaluation -->|All current suites have evidence| review
    review -->|Request changes| revisions
    review -->|Approve trusted revision| trusted
    trusted -->|Second recorded release decision| release
    release --> in_use
    in_use -->|Incident or recovery need| restore
    restore --> recovered

    %% Flow 10 Similar Prompt Check is out of scope for the MVP.
