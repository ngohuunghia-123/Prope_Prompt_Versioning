flowchart TD
    %% Sources: brainstorm/00_context.md Constraints, A-007, A-111, A-112, A-115,
    %% A-118 and access-control.lock.yml.

    start([Start: member opens a visible prompt property])
    permission{May manage access or transfer ownership?}
    denied[Access Management Unavailable]
    workspace[Access and Ownership]
    action{Choose action}

    scope[Set Private, Team, or Organization access level]
    grant[Select member and grant Viewer or Editor]
    revoke[Select an existing per-prompt grant]
    transfer[Select a new accountable owner]
    confirm{Confirm ownership transfer?}

    scope_saved[Access Level Changed and Activity Recorded]
    granted[Access Granted with actor, grantee, level, and timestamp]
    revoked[Access Revoked with actor, grantee, level, and timestamp]
    transferred[Owner Changed and Transfer Recorded]
    end_updated([End: access or ownership updated])

    start --> permission
    permission -->|No| denied
    denied -->|Return to prompt| end_updated
    permission -->|Yes| workspace
    workspace --> action
    action -->|Change default scope| scope
    scope --> scope_saved
    scope_saved --> end_updated
    action -->|Grant person-level access| grant
    grant --> granted
    granted --> end_updated
    action -->|Revoke person-level access| revoke
    revoke --> revoked
    revoked --> end_updated
    action -->|Transfer ownership| transfer
    transfer --> confirm
    confirm -->|Cancel| workspace
    confirm -->|Confirm| transferred
    transferred --> end_updated

    %% Viewer may read; Editor may also create revisions and edit eval suites.
    %% A per-prompt grant never confers approve, release, withdraw, or break-glass permission.
