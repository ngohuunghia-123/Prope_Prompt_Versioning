flowchart TD
    %% Sources: brainstorm/00_context.md Scope, A-002, A-024, A-032, A-047,
    %% ADR-0002 and prompt-registry.lock.yml.

    start([Start: owner or Editor changes a prompt])
    detail[Prompt Property Detail]
    permission{May edit this prompt?}
    denied[Revision Editing Unavailable]
    editor[Revision Editor]
    edit[Edit body, provider, upstream model, generation parameters, fallback answer, and change summary]
    validate{Revision fields valid?}
    invalid[Revision Validation]
    save{Append immutable revision succeeds?}
    failure[Save Failed - unsaved form retained]
    draft[New Draft Revision with revision number, version ID, author, and timestamp]
    history[Immutable Revision History]
    select_pair[Select any two revisions]
    compare[Side-by-Side Body and Runtime Diff]
    next{Next goal}
    end_draft([End: Draft revision and activity preserved])
    evaluation_handoff([Continue to 06 Prepare Evaluation Evidence])

    start --> detail
    detail -->|Edit| permission
    permission -->|No| denied
    denied -->|Return to prompt| detail
    permission -->|Yes| editor
    editor --> edit
    edit -->|Save revision| validate
    validate -->|No| invalid
    invalid -->|Correct fields| edit
    validate -->|Yes| save
    save -->|No| failure
    failure -->|Retry| edit
    failure -->|Cancel| detail
    save -->|Yes| draft
    draft --> history
    detail -->|View revisions| history
    history -->|Compare| select_pair
    select_pair --> compare
    history --> next
    compare --> next
    next -->|Edit again| editor
    next -->|Keep Draft| end_draft
    next -->|Prepare evidence| evaluation_handoff

    %% Existing revision rows are never updated or deleted; diff is computed on demand.
