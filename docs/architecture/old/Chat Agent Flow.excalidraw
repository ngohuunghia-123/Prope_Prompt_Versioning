      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787215428278,
      "link": null,
      "locked": false,
      "text": "◆ the settle and the write commit together,\n   or the audit trail says 'confirmed' beside a\n   registry that never heard about it.\n\n   The status predicate is what makes a\n   double click a no-op: zero rows changed,\n   answer already_decided.",
      "originalText": "◆ the settle and the write commit together,\n   or the audit trail says 'confirmed' beside a\n   registry that never heard about it.\n\n   The status predicate is what makes a\n   double click a no-op: zero rows changed,\n   answer already_decided.",
