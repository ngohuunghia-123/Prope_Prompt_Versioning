      "text": "ONE transaction\nconfirm_action → tools.CONFIRMED_EXECUTORS\nsettle_pending_action  AND status = 'pending'",
      "originalText": "ONE transaction\nconfirm_action → tools.CONFIRMED_EXECUTORS\nsettle_pending_action  AND status = 'pending'",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rec-0075",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "tex-0077",
      "type": "text",
      "x": 2380.0,
      "y": 210.0,
      "width": 473.3,
      "height": 166.2,
      "angle": 0,
      "strokeColor": "#7048e8",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
