      "boundElements": null,
      "updated": 1787215428278,
      "link": null,
      "locked": false,
      "text": "dspy_program.routing_of — the Action-Selector gate\n_INTENT_TOOLS: does this intent permit this tool?\nnot permitted → decision.dropped   (recorded, never run)\nconvert_prompt hoisted to the front — it is a barrier\nexactly one write survives; the rest → decision.deferred\nplan capped at MAX_PLAN_STEPS = 5",
      "originalText": "dspy_program.routing_of — the Action-Selector gate\n_INTENT_TOOLS: does this intent permit this tool?\nnot permitted → decision.dropped   (recorded, never run)\nconvert_prompt hoisted to the front — it is a barrier\nexactly one write survives; the rest → decision.deferred\nplan capped at MAX_PLAN_STEPS = 5",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rec-0029",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "tex-0031",
      "type": "text",
      "x": 1240.0,
      "y": 1180.0,
      "width": 513.6,
      "height": 308.8,
      "angle": 0,
      "strokeColor": "#7048e8",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a00031",
      "roundness": null,
      "seed": 1,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787215428278,
      "link": null,
      "locked": false,
      "text": "◆ the router proposes, this table disposes\n\n   move_prompt was reachable from NO intent:\n   the catalogue advertised it, the router emitted\n   it, and every one was deleted here in silence.\n   It is in manage_prompt AND manage_folder now.\n\n   create_folder is in manage_prompt too —\n   “move X into a new folder Y” is one sentence.\n\n   dropped is new: the gate's verdict is unchanged,\n   but the turn now knows it said no, so the reply\n   can say so too.",
      "originalText": "◆ the router proposes, this table disposes\n\n   move_prompt was reachable from NO intent:\n   the catalogue advertised it, the router emitted\n   it, and every one was deleted here in silence.\n   It is in manage_prompt AND manage_folder now.\n\n   create_folder is in manage_prompt too —\n   “move X into a new folder Y” is one sentence.\n\n   dropped is new: the gate's verdict is unchanged,\n   but the turn now knows it said no, so the reply\n   can say so too.",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
