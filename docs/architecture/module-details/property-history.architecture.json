      { "id": "vocabulary", "label": "Refuse an unregistered action", "focus": ["append", "cache", "check", "vocabulary"], "note": "The vocabulary is closed and loaded once at process start: a new action is a migration plus a restart, never a constant (ADR-0038)." },
      { "id": "undeletable", "label": "Why nothing can be deleted", "focus": ["privileges", "event", "rls"], "note": "prope_app holds SELECT and INSERT and never UPDATE or DELETE. Only prope_migrate holds those, and the running process is not it." },
