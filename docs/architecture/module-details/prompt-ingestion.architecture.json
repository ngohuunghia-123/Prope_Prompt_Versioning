  "cards": [
    { "dot": "cyan", "title": "Surface", "items": [
      "POST /import-batches: files or one table, 20 MB, 100 items, 202 Accepted",
      "GET the batch and its items; PATCH one item under expected_version",
      "POST retry, POST commit-proposals, POST /action-proposals/{id}/decision",
      "Every batch is also recorded as an agent run of kind import"
    ] },
    { "dot": "emerald", "title": "Inside", "items": [
      "Owns the ingestion schema: import_batch, import_item, commit_proposal",
      "All three tables are tenant-RLS enabled by migration 0041",
      "A worker claims items ~1 s apart: SKIP LOCKED, 5-minute lease, 3 attempts",
      "Duplicate check is semantic: top 3 matches at similarity 0.55 or above"
    ] },
    { "dot": "rose", "title": "Guarantees", "items": [
      "No lock file exists for this module — as-built from code at commit e01be18",
      "Only ready items resolved create or revise may enter a commit proposal",
      "Permission is checked again per item at commit; a refusal fails one item",
      "A stale item_version or a moved base version refuses that item, not the batch"
    ] }
