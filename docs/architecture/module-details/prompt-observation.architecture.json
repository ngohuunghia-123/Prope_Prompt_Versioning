  "cards": [
    { "dot": "cyan", "title": "Surface", "items": [
      "GET /api/v1/observations — the punch list, newest and busiest first",
      "POST .../proposal hands back a body and a name, and writes nothing",
      "adopt is the corrective action; dismiss is a legitimate resolution (A-162)",
      "Every refusal is not-found — a 403 would disclose that the row exists"
    ] },
    { "dot": "emerald", "title": "Inside", "items": [
      "Two tables in its own observation schema; it reads no other module's",
      "fingerprint() hashes the normalised system message; user turns are dropped",
      "A sighting is stored only when it changed the body — the rest is a counter",
      "difflib and nothing more (A-012); a direct write, with no second queue"
    ] },
    { "dot": "rose", "title": "Guarantees", "items": [
      "ADR-0064 — a migration audit, not an adoption path (ADR-0063, A-161)",
      "An open row is work outstanding; an empty inbox is the success condition",
      "It writes no prompt and no revision — a person posts the proposal (ADR-0060)",
      "RLS deny-by-default on both tables; a missing workspace id returns zero rows"
    ] }
  ]
