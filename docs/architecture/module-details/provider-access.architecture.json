    { "dot": "emerald", "title": "Inside", "items": [
      "Owns three tables; the ciphertext sits in its own, so SELECT * cannot leak it",
      "The decrypted secret lives in a 60 s process-local cache and nowhere else (A-092)",
      "Admission caps are per process — 24 interactive in app, 8 batch in worker (ADR-0046)",
      "Token counts come from the provider's own usage object, within ±2 % (A-030)"
    ] },
    { "dot": "rose", "title": "Guarantees", "items": [
      "Forbidden edge: no other module may reach the credential store",
      "No read API, error body or history event returns the credential (AC-1)",
      "Exactly one attempt per dispatch — the retry policy is the caller's (A-088)",
      "A provider that reports no usage object never goes active (A-030, A-090)"
    ] }
