    "views": [
      {
        "id": "sweep",
        "label": "Sweep for degradation",
        "focus": [
          "access",
          "registry",
          "sweep",
          "detectors",
          "finding"
        ],
        "note": "Daily, free, on by default: arithmetic over call metadata through ADR-0055's one read path. No model decides whether an anomaly is real."
      },
      {
        "id": "gate",
        "label": "Gate before a person sees it",
        "focus": [
          "triage",
          "gate",
          "evaluation",
          "proposal"
        ],
        "note": "A candidate clears the prompt's own suite or it is discarded and counted. An unvalidated queue turns approval into a rubber stamp."
      },
      {
        "id": "reprobe",
        "label": "Re-probe what is live",
        "focus": [
          "readiness",
          "probes",
          "detectors"
        ],
        "note": "Weekly and opt-in, on the workspace's credential: prompt-readiness's probe runner re-run against the LIVE released revision."
      },
      {
        "id": "decide",
        "label": "Decide, and record it",
        "focus": [
          "finding",
          "proposal",
          "surface",
          "reviewer",
          "history"
        ],
        "note": "Accept records the disposition and hands back the body; the revision write is a separate, explicit request the person makes (SR-6)."
      }
    ]
  },
