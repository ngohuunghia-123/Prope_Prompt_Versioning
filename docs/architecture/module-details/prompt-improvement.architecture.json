  "cards": [
    {
      "dot": "cyan",
      "title": "Surface",
      "items": [
        "GET /improvement/findings — the inbox, filtered per reader (INT-045)",
        "GET /prompts/{id}/findings, beside ADR-0055's call-records tab",
        "POST /proposals/{id}/accept records the decision and returns the body",
        "The inbox omits an unseen prompt identically to one with nothing wrong (SR-7)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Inside",
      "items": [
        "Two evidence sources, and neither reads a request or a response body (SR-1)",
        "No HTTP client, no mail library, no socket — delivery is pull-only (SR-5)",
        "Imported, never duplicated: prompt-readiness's probe runner, finding shape, profile reader, evidence rail",
        "Also owns improvement.sweep (indefinite) and improvement.schedule (off by default)"
      ]
    },
    {
      "dot": "rose",
      "title": "Guarantees",
      "items": [
        "A candidate that regresses is discarded, counted, and never rendered (SR-3)",
        "No suite, no edit proposal — for every anomaly and every family (AC-5)",
        "One open proposal per prompt, refused by a partial unique index (SR-2)",
        "A rationale rides collapsed beside the diff, never instead of it (ADR-0070)"
      ]
    }
  ]
