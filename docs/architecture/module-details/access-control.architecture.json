  "cards": [
    { "dot": "cyan", "title": "Surface", "items": [
      "Five in-process seams (INT-001…INT-005); 16 HTTP ops over 13 paths",
      "may() answers allow or deny only — no reason, no partial answer",
      "Edit, review and release stay separate at every scope (A-112)",
      "POST /api/v1/auth/login is the only unauthenticated route"
    ] },
    { "dot": "emerald", "title": "Inside", "items": [
      "Ten tables under RLS; lookup_session, lookup_api_key, list_workspaces are the only bypasses",
      "Nothing is cached, and no caller may cache an answer — revocation lands next request",
      "Two secrets, two primitives: argon2id for passwords, SHA-256 for keys (ADR-0021)",
      "The login limiter rejects before the hash: 5 per email, 20 per address"
    ] },
    { "dot": "rose", "title": "Guarantees", "items": [
      "Permission is local — the caller passes owner_id and access_level (ADR-0020)",
      "A private prompt is not-found, never forbidden — even by exact title (AC-1)",
      "A rate-limited login is byte- and timing-identical to a wrong password (A-144)",
      "Stripping the last Admin is refused before the write, not repaired after (A-117)"
    ] }
  ]
