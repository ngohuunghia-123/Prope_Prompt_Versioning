  "cards": [
    { "dot": "cyan", "title": "Surface", "items": [
      "POST /v1/chat/completions, streaming and non-streaming",
      "GET /v1/models lists what this key may resolve and has a release",
      "Every response names what served it: version id, revision, pinned, fallback"
    ] },
    { "dot": "emerald", "title": "Inside", "items": [
      "Owns no database schema — the only state is a 30 s in-process LRU",
      "Permission is re-checked on every request; only the binding is cached",
      "One 60 s budget is spent across the whole route, not per rung (ADR-0069)",
      "At most 20 in-flight calls per key, refused rather than queued (A-143)"
    ] },
    { "dot": "rose", "title": "Guarantees", "items": [
      "A pin to a revision that is not Approved is refused (BR-03)",
      "A key-scope refusal is byte-identical to an unknown model name (A-116)",
      "The fallback is served only before the first byte reaches the caller (A-033)",
      "The call record reaches call-ledger after the flush, never before (A-087)"
    ] }
  ]
