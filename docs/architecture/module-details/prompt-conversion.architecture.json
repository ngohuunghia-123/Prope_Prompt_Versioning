  "cards": [
    { "dot": "cyan", "title": "Surface", "items": [
      "POST /api/v1/prompt-conversions → xml_body, model, schema_version",
      "TXT, Markdown, JSON and YAML only — no PDF, no DOCX, nothing binary",
      "chat-orchestrator and prompt-ingestion call convert_source() in process",
      "422 invalid source · 502 invalid agent output · 503 breaker open"
    ] },
    { "dot": "emerald", "title": "Inside", "items": [
      "Owns no table — the provenance columns are registry.revision's (alembic 0013)",
      "content_coverage scores every success deterministically; no LLM-as-judge anywhere",
      "Its own circuit breaker and its own eight metric series, split from prompt-search",
      "DSPy costs 11 s to import, so it is warmed in a thread at startup, off the loop"
    ] },
    { "dot": "rose", "title": "Guarantees", "items": [
      "Conversion never saves a revision — the author reviews the XML, then saves",
      "A compiled artifact contributes demonstrations; the human instruction wins",
      "Only bootstrap_prompt.py may label a Langfuse version — the optimizer proposes",
      "No source text, rendered prompt or completion reaches Langfuse, a log, or disk"
    ] }
