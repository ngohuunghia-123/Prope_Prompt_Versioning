  "cards": [
    { "dot": "cyan", "title": "Surface", "items": [
      "GET .../readiness returns the card — and past Draft, performs the freeze",
      "POST .../probe spends the workspace's own credit, behind probe.start",
      "POST .../case-drafts and POST .../readiness/dismissals, both prompt-scoped",
      "GET /readiness/rules is the closed catalogue a client renders codes from"
    ] },
    { "dot": "emerald", "title": "Inside", "items": [
      "Five tables in readiness; every index leads with workspace_id",
      "Lane A is free and unasked; Lane C dispatches one call per case; Lane B is on request only",
      "The red-team sets are files in the image — builtin:<slug>@N, never rows",
      "A dismissal is per (workspace, prompt, rule) and outlives the revision"
    ] },
    { "dot": "rose", "title": "Guarantees", "items": [
      "Nothing blocks: the severity CHECK admits advice and warning only (SR-3)",
      "A probe writes no evaluation.eval_run row and enters no cost delta (SR-4)",
      "release-control is forbidden in both directions — the read freezes (SR-1)",
      "The evidence rail runs before storage, never before render (SR-7)"
    ] }
