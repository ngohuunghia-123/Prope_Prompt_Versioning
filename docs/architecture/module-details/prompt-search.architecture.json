  "cards": [
    { "dot": "cyan", "title": "Surface", "items": [
      "GET /prompts/search — quick keyword or AI mode, cursor-paged",
      "POST /prompts/search/similar — a pasted body, answered as an SSE trace",
      "POST / GET / DELETE /prompts/{id}/index and GET /prompt-search/jobs/{id} — the button path",
      "chat-orchestrator calls semantic_search() in process; saving a revision publishes a job"
    ] },
    { "dot": "emerald", "title": "Inside", "items": [
      "Owns search.prompt_search_index — two rows per prompt, role latest and role released (0014)",
      "Also owns the index-job table and search.embedding_cache, both workspace-scoped by RLS",
      "content_embedding covers title + purpose + body, never purpose alone",
      "output_descriptor is extracted once per revision at index time, never per pair (0035)"
    ] },
    { "dot": "rose", "title": "Guarantees", "items": [
      "Every read runs behind visible_subject_filter: a hidden prompt is absent, not forbidden",
      "The index accelerates; an unindexed prompt is still found, marked is_indexed false",
      "Findings are codes with parameters, never prose — the client translates (ADR-0053)",
      "No sheet ever recommends discarding a prompt: use-existing needs measurement that does not run here"
    ] }
  ]
