  "cards": [
    { "dot": "cyan", "title": "Surface", "items": [
      "GET / POST /api/v1/prompts, the revision chain under each one, and the folder grid",
      "GET /prompts/{id}/diff and /prompts/{id}/activity — the two reads the review screen makes",
      "Six in-process seams: resolve, list_released, and release-control's three commands",
      "prompt-observation hands back an adoption proposal; these create routes do the write"
    ] },
    { "dot": "emerald", "title": "Inside", "items": [
      "registry.revision is append-only by PRIVILEGE: no DELETE, and GRANT UPDATE (status) only",
      "search_text is a second copy of the body, trigger-maintained, named by no response model",
      "The diff is computed on demand and never stored — a stored diff is a third copy (A-047)",
      "trial.py composes a Draft through the shared prope.prompt_composition, never the gateway"
    ] },
    { "dot": "rose", "title": "Guarantees", "items": [
      "Only an Approved revision may be released — a composite foreign key, not an if (BR-03)",
      "release-control writes the released pointer through INT-013; registry never calls back",
      "A prompt the actor cannot see answers not-found, byte-identical to an id that never existed",
      "Every list read takes a VisibleFilter; the one named unsafe bypass trips a page-now counter"
    ] }
  ]
