      { "id": "release", "label": "Move the released pointer", "focus": ["decision", "release", "releases", "registry"], "note": "The pointer is a prompt-registry field only this module writes, and a composite foreign key refuses any target that is not Approved." },
      { "id": "break-glass", "label": "Break the glass, on the record", "focus": ["release", "releases", "tasks"], "note": "No approval row, a mandatory reason, break_glass = true — and a follow-up task due in 24 hours that never closes itself." },
      { "id": "withdraw", "label": "Take it out of production", "focus": ["surface", "gate", "release", "registry"], "note": "Its own permission and its own reason. The pointer is cleared; the gateway stops resolving the name within 30 seconds (ADR-0012)." }
