  "cards": [
    { "dot": "cyan", "title": "Surface", "items": [
      "GET .../review composes prompt-registry's diff with evaluation's pass/fail and cost delta",
      "POST .../approve, .../request-changes, .../approve-and-release — one request, two rows, one transaction",
      "POST .../releases (release | restore), .../releases/break-glass, .../releases/withdraw",
      "GET /review-tasks is the whole notification channel; nothing leaves the product (A-071)"
    ] },
    { "dot": "emerald", "title": "Inside", "items": [
      "The evidence digest is frozen onto the approval — what the reviewer saw, never a later recompute (A-074)",
      "Unknown eval evidence is treated like failing evidence: the acknowledgement reason turns mandatory (A-070)",
      "The pointer write is a compare-and-set; the loser is refused and told what is released now (A-072)",
      "A worker sweep counts overdue break-glass follow-ups and reconciles released pointers (ADR-0051)"
    ] },
    { "dot": "rose", "title": "Guarantees", "items": [
      "No auto-release of any kind — every release carries a person's recorded decision",
      "Only an Approved revision may be released: a composite foreign key, not an if (BR-03, ADR-0001)",
      "Edit, review/approve and release are separate permissions; self-approval is recorded, never refused (A-008)",
      "A prompt the actor cannot see is not-found, never forbidden; break-glass is counted and owes a 24 h task (A-009)"
    ] }
  ]
