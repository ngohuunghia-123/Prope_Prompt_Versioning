  "cards": [
    { "dot": "cyan", "title": "Surface", "items": [
      "23 routes under /api/v1 — suites, datasets, attachments, runs, comparison",
      "POST /prompts/{id}/eval-runs returns 202 with one run id per suite",
      "get_review_summary() is an in-process pull, not an HTTP endpoint",
      "Every route resolves may() against the prompt row it already read"
    ] },
    { "dot": "emerald", "title": "Inside", "items": [
      "Eight tables under RLS; eval_suite is append-only, a dataset deliberately is not",
      "eval_run.status is the queue — this module touches no broker (ADR-0049)",
      "Both containers: the routes in app, the claim loop and the sweeper in worker",
      "A dataset materialises into an immutable suite version at run time"
    ] },
    { "dot": "rose", "title": "Guarantees", "items": [
      "Only provider-access dispatches a case — the gateway is a forbidden edge (A-043)",
      "Release-control pulls the summary; evaluation never calls back (A-042)",
      "A dispatch error is outcome=error, never fail, and the cost delta is withheld (A-057)",
      "Cost warns at +20% and never blocks; a reached spend ceiling refuses the run (A-016, A-029)"
    ] }
  ]
