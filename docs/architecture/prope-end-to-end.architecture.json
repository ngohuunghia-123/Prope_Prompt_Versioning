  "cards": [
    { "dot": "cyan", "title": "Two front doors, one origin", "items": ["The SPA sends a session cookie to /api/v1/*, a consuming app sends an API key to /v1/*", "Every module route resolves its actor through access-control first: may(actor, action, subject)"] },
    { "dot": "emerald", "title": "Nothing ships without a human", "items": ["Release-control runs the candidate against the released baseline, then writes the released pointer", "Only an Approved revision may be released — enforced by a database constraint, not by app code"] },
    { "dot": "violet", "title": "Every call is traceable", "items": ["Provider-access alone decrypts a workspace credential and makes one upstream attempt", "The record is enqueued after the response flushes; the worker drains, prices and persists it"] }
  ]
