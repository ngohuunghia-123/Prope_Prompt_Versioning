  "cards": [
    {
      "dot": "cyan",
      "title": "Management path",
      "items": [
        "Session-cookie /api/v1/* through one Caddy origin",
        "access-control checks may(actor, action, subject) — no local policy copies",
        "Immutable revisions; approve + release append to property history"
      ]
    },
    {
      "dot": "violet",
      "title": "Gateway /v1",
      "items": [
        "OpenAI-compatible; serves only Approved + Released revisions",
        "Exactly one provider dispatch; marked fallback if upstream fails early",
        "Call records enqueued after response flush; eval runs use batch priority"
      ]
    },
    {
      "dot": "rose",
      "title": "Secrets & async",
      "items": [
        "AES-GCM credentials, KEK outside DB; provider egress only via provider-access",
        "Worker: ledger drain + pricing, indexing, retention — no HTTP surface",
        "RLS isolates every schema; Prometheus scrapes app /metrics only"
      ]
    }
  ]
