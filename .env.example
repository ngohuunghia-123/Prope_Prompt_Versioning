# Prope local development configuration.
# Copy to .env. Keep .env private; it is ignored by Git.

# PostgreSQL roles. The migrate job uses the first two; app/worker run as
# prope_app and must never receive the migrate/report credentials.
POSTGRES_PASSWORD=replace-with-a-random-password
PROPE_MIGRATE_PASSWORD=replace-with-a-random-password
PROPE_APP_PASSWORD=replace-with-a-random-password
PROPE_REPORT_PASSWORD=replace-with-a-random-password

# RabbitMQ and Grafana local accounts.
RABBITMQ_DEFAULT_USER=prope
RABBITMQ_DEFAULT_PASS=replace-with-a-random-password
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-password

# Required for provider credentials at rest. Generate 32 random bytes as base64,
# for example in PowerShell:
# $bytes = [byte[]]::new(32)
# [Security.Cryptography.RandomNumberGenerator]::Fill($bytes)
# [Convert]::ToBase64String($bytes)
PROPE_KEK_V1=

# Development only. docker-compose.yml already sets the session cookie to
# non-Secure for local HTTP. Do not set PROPE_COOKIE_SECURE=false in production.
APP_ENV=development
# ADMIN_SESSION_TOKEN=

# App-owned AI for prompt conversion, chat orchestration, search extraction,
# evaluation dataset drafting, and embeddings. This is separate from each
# workspace's BYOK provider configuration.
APP_OPENAI_BASE_URL=https://api.openai.com/v1
APP_OPENAI_API_KEY=
APP_AGENT_MODEL=gpt-4o-mini
APP_EMBEDDING_MODEL=text-embedding-3-small

# Optional separate OpenAI-compatible embedding endpoint. Empty values fall
# back to APP_OPENAI_* and APP_EMBEDDING_MODEL.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Width the provider must answer with. Both vector columns are vector(1536),
# and a model of another width raises on the insert rather than storing. Ask
# for the width you need: for a Matryoshka-trained model a 1536-wide answer is
# a shorter embedding, not a truncated array. Leave EMPTY to omit the parameter,
# which legacy text-embedding-ada-002 requires.
EMBEDDING_DIMENSIONS=1536
# Seconds per attempt, with three retries on top. The agent's 5s is tuned for a
# chat completion; a large embedding model on a shared host answers in ~10s cold,
# and a timeout below that burns an attempt on every request.
EMBEDDING_TIMEOUT_SECONDS=30

# Optional observability and managed prompt versions. All may stay empty:
# Prope falls back to built-in instructions and Prometheus/structured logs.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Optional application-agent tuning. Keep price settings aligned with
# APP_AGENT_MODEL; values are USD per million tokens.
APP_AGENT_MAX_OUTPUT_TOKENS=12000
APP_AGENT_PRICE_INPUT_PER_MTOK=0.15
APP_AGENT_PRICE_OUTPUT_PER_MTOK=0.60
PROMPT_CONVERSION_DSPY_PROGRAM=
PROMPT_SEARCH_MAX_OUTPUT_TOKENS=2000
PROMPT_SEARCH_BODY_CHAR_LIMIT=4000
PROMPT_SEARCH_DSPY_PROGRAM=

# Optional operations settings.
# PROPE_RETENTION_CHUNK_SIZE=5000
# PROPE_SITE_ADDRESS=:80
# PROMPT_SEARCH_RANKER=blend
# PROMPT_SEARCH_LEXICAL_BONUS=0.08
# PROMPT_SEARCH_RRF_K=60
# PROMPT_SEARCH_ALPHA=0.7
# PROMPT_SEARCH_MIN_SIMILARITY=0.25
# PROMPT_SEARCH_MIN_LEXICAL=0.15
# PROMPT_SEARCH_MAX_DF_SHARE=0.25
# PROMPT_SEARCH_SPECIFIC_DF_SHARE=0.05
# PROMPT_SEARCH_MIN_ANCHOR_LENGTH=4
# PROMPT_SEARCH_MIN_CORPUS_FOR_DF=20
# PROMPT_SEARCH_LEXICAL_WEIGHT=0.5
# PROMPT_SEARCH_INDEX_DOCUMENT=enriched

# Optional chat research leg (tools_research). Unset means the assistant's
# `research_topic` tool refuses every call and the improve-prompt flow relies on
# the internal documentation corpus only. When set, it must point at a search
# API accepting POST {query, max_results} -> {results: [{url, title, content}]};
# answers from domains outside the allow-list are dropped before they become
# citations.
# CHAT_RESEARCH_API_URL=
# CHAT_RESEARCH_API_KEY=
# CHAT_RESEARCH_ALLOWED_DOMAINS=anthropic.com,openai.com,owasp.org,arxiv.org

# Chat drafter token budget (instruction-shaped revision bodies).
CHAT_DRAFT_MAX_OUTPUT_TOKENS=2000

# Per-program model overrides for the chat orchestrator. Unset means
# APP_AGENT_MODEL. Point the router at the fastest classification model your
# gateway offers — it runs on every turn and its output is a few short fields,
# so a slow large model here is pure latency.
# CHAT_ROUTER_MODEL=
# CHAT_REPLY_MODEL=
# CHAT_DRAFT_MODEL=

# Router fail-fast bounds. The router is the first call of every turn; one
# attempt with a hard timeout fails into the graceful-unavailable message in
# seconds instead of holding the turn open through silent retries.
# CHAT_ROUTER_NUM_RETRIES=1
# CHAT_ROUTER_TIMEOUT_SECONDS=12
