# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
## Development-only, fixed browser/CLI operator session. Generate with:
## python -c "import secrets; print('ses_' + secrets.token_urlsafe(32))"
# ADMIN_SESSION_TOKEN=
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
# Master switch for automatic prompt capture (AI tool hooks + the pre-push
# Antigravity sweep). Only 1/true/yes/on turns logging on — any other value,
# or removing the line, turns it off. Submitting logs already captured in
# .ai-log/ is not affected by this switch.
AI_LOG=true
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================
# Prope — ADR-0032's `.env` for docker-compose.yml
# ============================================
# The three Prope-specific `PROPE_DATABASE_URL` values docker-compose.yml
# builds live here as their component passwords — not as one URL — because
# the same env var name needs a different value for `migrate` (superuser)
# than for `app`/`worker` (the `prope_app` role). See docker-compose.yml and
# alembic/bootstrap_roles.py.

# The postgres image's own superuser, used once by the `migrate` service.
POSTGRES_PASSWORD=

# The three roles revision 0001 creates with no password (D-05). `migrate`
# sets these via alembic/bootstrap_roles.py right after `alembic upgrade
# head`; `app`/`worker` connect as prope_app afterward.
PROPE_MIGRATE_PASSWORD=
PROPE_APP_PASSWORD=
PROPE_REPORT_PASSWORD=

# ADR-0028.
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

GRAFANA_ADMIN_PASSWORD=

# D-12's operator override for the retention sweep's chunk size. Optional —
# leave commented out to use prope.call_ledger.retention.DEFAULT_CHUNK_SIZE.
# PROPE_RETENTION_CHUNK_SIZE=5000

# ---- Prompt Search app-owned AI ----
# These credentials are isolated from user-configured BYOK providers.
APP_OPENAI_BASE_URL=https://api.openai.com/v1
APP_OPENAI_API_KEY=
APP_AGENT_MODEL=gpt-4o-mini
APP_EMBEDDING_MODEL=text-embedding-3-small
SEARCH_DUPLICATE_THRESHOLD=0.9

# ---- Embeddings, when they do not live where the agent lives ----
# An OpenAI-compatible gateway may serve `/chat/completions` and answer 404 on
# `/embeddings` — a common shape for gateways fronting other vendors' chat
# models. Set these to send semantic search somewhere that does serve it; each
# falls back to its APP_* counterpart above when left empty, so a single-provider
# deployment leaves all three blank.
#
# EMBEDDING_MODEL is written into every index row and every cache key: changing
# it marks existing indexes STALE and they must be re-indexed, which is correct —
# vectors from two different models were never comparable.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Optional CLI playground configuration.
PROMPT_SEARCH_API_URL=http://localhost:8000
PROMPT_SEARCH_API_KEY=

# ---- Prompt Conversion: the app agent's budget and its bill ----
# `prope_prompt_conversion_cost_usd_total` is computed from these, so they move
# WITH APP_AGENT_MODEL. Per MILLION tokens; the defaults are gpt-4o-mini's.
# Output is 4-6x input at every provider, which is why they are two settings.
APP_AGENT_MAX_OUTPUT_TOKENS=12000
APP_AGENT_PRICE_INPUT_PER_MTOK=0.15
APP_AGENT_PRICE_OUTPUT_PER_MTOK=0.60

# A DSPy artifact compiled by `python -m prope.prompt_conversion.optimize`.
# Leave EMPTY for the zero-shot program. Setting it loads the artifact's
# few-shot demonstrations only: the conversion instruction always comes from the
# Langfuse `production` label, so an artifact cannot change what the agent is
# told to do -- only how well it has been shown to do it.
PROMPT_CONVERSION_DSPY_PROGRAM=

# ---- Langfuse (ADR-0030's fourth pillar + the managed conversion prompt) ----
# Two jobs, one integration:
#   1. TRACING     -- a span tree per conversion, with token usage and cost
#                     attributed to the prompt version that produced them.
#   2. PROMPT MGMT -- `prope/prompt-conversion` is fetched by the `production`
#                     label, so the agent's instruction is edited and promoted
#                     by a human in Langfuse rather than by a redeploy.
#
# **All three may be left empty.** `get_langfuse()` returns None, every span
# becomes a no-op, and conversion runs on Prometheus + JSON logs alone with the
# instruction compiled into the image. That degradation is counted, not silent:
# watch `prope_prompt_conversion_prompt_fallback_total`.
#
# **What is deliberately NOT sent: source_text, the rendered prompt, the model's
# completion, or any block content.** Only metadata, token counts, and scores.
# See `prompt_conversion/service.py` for where that is enforced.
#
# Seed the prompt once against a fresh project:
#   uv run python -m prope.prompt_conversion.bootstrap_prompt
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud is https://cloud.langfuse.com, US is https://us.cloud.langfuse.com,
# self-hosted is your own URL. PDPL treats a foreign host as a cross-border
# transfer, so a Vietnamese pilot should prefer a self-hosted instance.
LANGFUSE_HOST=
