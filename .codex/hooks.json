{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git ai-log --tool=codex",
            "commandWindows": "cmd.exe /d /c \"git ai-log --tool=codex\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git ai-log --tool=codex",
            "commandWindows": "cmd.exe /d /c \"git ai-log --tool=codex\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
