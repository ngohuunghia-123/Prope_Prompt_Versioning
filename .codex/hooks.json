{
  "description": "Log Codex prompts and stops",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/log_hook.mjs --tool=codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/log_hook.mjs --tool=codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
