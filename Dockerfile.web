# image 2 of 2 — prope-web. ADR-0052, ADR-0033, ADR-0031.
#
# **Node runs in CI only.** This file is the whole of where it runs: the build
# stage emits static bytes and is thrown away, and what ships is `caddy:2` with a
# directory in it. The service count stays at SEVEN — there is no `web` container
# and no Node process to keep alive, patch, or debug at 3am, which is the half of
# ADR-0034's argument that survives its own reversal intact.
#
# **The SPA is baked in rather than mounted from a volume**, and ADR-0052 rejected
# the volume by name: the UI and the API would then version independently, so a
# rollback of `prope-app` would leave the previous deploy's SPA calling the current
# API and ADR-0031's *"the tested artefact is the deployed one"* would stop being
# true for the frontend.
#
# ADR-0052 sketches this file with `web/` and `npm ci`. The source lives at
# `src/prope-fe` and the project uses **pnpm** — `package.json` pins
# `packageManager` and there is a `pnpm-lock.yaml` — so the paths and the commands
# differ from the sketch while the shape does not.

FROM node:22-bookworm-slim AS build

# Corepack ships with Node and reads `packageManager` from package.json, so the
# pnpm version is the lockfile's rather than whatever the image happened to have.
RUN corepack enable

WORKDIR /src

# Manifest and lockfile first, so a change to a component does not invalidate the
# dependency layer. `--frozen-lockfile` is the point of copying the lockfile at
# all: a resolution that drifted from `pnpm-lock.yaml` is a build that installed
# something nobody reviewed.
COPY src/prope-fe/package.json src/prope-fe/pnpm-lock.yaml src/prope-fe/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY src/prope-fe/ ./

# `pnpm build` is `tsc -b && node scripts/run-vite.mjs build`, so **a type error
# fails the image**. That is deliberate: the SPA is the API's first-party client,
# and a build that shipped despite a broken response shape would move the failure
# to a browser somebody is using.
#
# `run-vite.mjs` prefers `node_modules/node/bin/node` when it exists — a Windows
# workaround the repo pins as a devDependency. On this image that resolves to the
# linux build of the same 22.x and the wrapper is a no-op; `pnpm-workspace.yaml`
# already allows that package's postinstall, which is what puts the binary there.
RUN pnpm build

FROM caddy:2

COPY --from=build /src/dist /srv
COPY Caddyfile /etc/caddy/Caddyfile
